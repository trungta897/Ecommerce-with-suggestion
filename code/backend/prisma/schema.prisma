generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  passwordHash  String
  fullName      String
  phone         String?            @unique
  address       String?
  avatarUrl     String?
  provider      AuthProvider       @default(LOCAL)
  googleId      String?            @unique
  role          UserRole           @default(CUSTOMER)
  isActive      Boolean            @default(true)
  isVerified    Boolean            @default(false)
  vipPoints     Int                @default(0)
  vipPointsDebt Int                @default(0)
  lastLoginAt   DateTime?
  passwordSetAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  cartItems     CartItem[]
  emailLogs     EmailLog[]
  orders        Order[]
  reviews       Review[]
  activityLogs  UserActivityLog[]
  voucherUsages UserVoucherUsage[]
  wishlists     Wishlist[]

  @@map("users")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryToSub", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToSub")
  products    Product[]
  vouchers    Voucher[]

  @@index([parentId], map: "categories_parentId_fkey")
  @@map("categories")
}

model Product {
  id               String                  @id @default(uuid())
  categoryId       String
  name             String
  slug             String                  @unique
  brand            String?
  description      String?                 @db.Text
  specifications   Json?
  tags             Json?
  price            Decimal                 @db.Decimal(12, 2)
  discountPrice    Decimal?                @db.Decimal(12, 2)
  stock            Int                     @default(0)
  images           Json?
  sourceExternalId String?
  viewCount        Int                     @default(0)
  soldCount        Int                     @default(0)
  avgRating        Float                   @default(0)
  reviewCount      Int                     @default(0)
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  cartItems        CartItem[]
  orderItems       OrderItem[]
  recommendedFrom  ProductRecommendation[] @relation("source")
  recommendedTo    ProductRecommendation[] @relation("target")
  category         Category                @relation(fields: [categoryId], references: [id])
  reviews          Review[]
  activityLogs     UserActivityLog[]
  wishlists        Wishlist[]
  vouchers         Voucher[]
  discounts        ProductDiscount[]

  @@index([categoryId])
  @@index([brand])
  @@index([soldCount])
  @@index([viewCount])
  @@index([categoryId, isActive, soldCount])
  @@map("products")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@index([productId], map: "cart_items_productId_fkey")
  @@map("cart_items")
}

model Order {
  id                 String             @id @default(uuid())
  userId             String?
  status             OrderStatus        @default(PENDING)
  subtotal           Decimal            @db.Decimal(12, 2)
  discountAmount     Decimal            @default(0.00) @db.Decimal(12, 2)
  shippingFee        Decimal            @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal            @db.Decimal(12, 2)
  shippingName       String
  shippingAddress    String
  shippingPhone      String
  deliveryMethod     String?
  deliveryPartner    String?
  trackingId         String?
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus      @default(PENDING)
  paymentExpiresAt   DateTime?
  depositAmount      Decimal?           @db.Decimal(12, 2)
  isDepositPayment   Boolean            @default(false)
  pickupTime         DateTime?
  earnedVipPoints    Int                @default(0)
  usedVipPoints      Int                @default(0)
  vipDiscountAmount  Decimal            @default(0.00) @db.Decimal(12, 2)
  pointsCreditedAt   DateTime?
  isOrphanedPayment  Boolean            @default(false)
  refundStatus       RefundStatus?
  completedAt        DateTime?
  returnReason       ReturnReason?
  returnNote         String?            @db.Text
  returnEvidenceUrls Json?
  returnRequestedAt  DateTime?
  returnResolvedAt   DateTime?
  returnRejectReason String?            @db.Text
  auditTrail            Json?
  paymentGatewayTxnId   String?
  paymentGatewayTransNo String?
  paymentGatewayPayDate String?
  voucherId             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  items              OrderItem[]
  user               User?              @relation(fields: [userId], references: [id])
  voucher            Voucher?           @relation(fields: [voucherId], references: [id])
  voucherUsage       UserVoucherUsage[]

  @@index([shippingPhone])
  @@index([userId], map: "orders_userId_fkey")
  @@index([voucherId], map: "orders_voucherId_fkey")
  @@map("orders")
}

model Voucher {
  id            String             @id @default(uuid())
  code          String             @unique
  type          VoucherType
  scope         VoucherScope       @default(CART)
  value         Decimal            @db.Decimal(12, 2)
  minOrderValue Decimal            @default(0.00) @db.Decimal(12, 2)
  maxDiscount   Decimal?           @db.Decimal(12, 2)
  usageLimit    Int?
  usedCount     Int                @default(0)
  perUserLimit  Int                @default(1)
  isPublic      Boolean            @default(true)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean            @default(true)
  categoryId    String?
  productId     String?
  createdAt     DateTime           @default(now())
  category      Category?          @relation(fields: [categoryId], references: [id])
  product       Product?           @relation(fields: [productId], references: [id])
  orders        Order[]
  usages        UserVoucherUsage[]

  @@index([categoryId])
  @@index([productId])
  @@map("vouchers")
}

model UserVoucherUsage {
  id        String   @id @default(uuid())
  userId    String?
  voucherId String
  orderId   String
  usedAt    DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
  voucher   Voucher  @relation(fields: [voucherId], references: [id])

  @@index([userId, voucherId])
  @@index([orderId], map: "user_voucher_usage_orderId_fkey")
  @@index([voucherId], map: "user_voucher_usage_voucherId_fkey")
  @@map("user_voucher_usage")
}

model OrderItem {
  id                String           @id @default(uuid())
  orderId           String
  productId         String
  productDiscountId String?
  quantity          Int
  unitPrice         Decimal          @db.Decimal(12, 2)
  subtotal          Decimal          @db.Decimal(12, 2)
  order             Order            @relation(fields: [orderId], references: [id])
  product           Product          @relation(fields: [productId], references: [id])
  productDiscount   ProductDiscount? @relation(fields: [productDiscountId], references: [id])

  @@index([orderId], map: "order_items_orderId_fkey")
  @@index([productId], map: "order_items_productId_fkey")
  @@index([productDiscountId], map: "order_items_productDiscountId_fkey")
  @@map("order_items")
}

model ProductDiscount {
  id            String      @id @default(uuid())
  productId     String      // Không @unique: cho phép lên lịch nhiều đợt tương lai
  discountPrice Decimal     @db.Decimal(12, 2)
  flashSaleQty  Int         // Tổng số suất flash sale mở bán
  flashSaleSold Int         @default(0) // Số suất đã được giữ/bán
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([productId, isActive]) // Partial index: hỗ trợ query tìm đợt active theo sản phẩm
  @@map("product_discounts")
}

model Review {
  id                 String       @id @default(uuid())
  userId             String
  productId          String
  orderId            String?
  rating             Int
  title              String?
  content            String?      @db.Text
  isVerifiedPurchase Boolean      @default(false)
  helpfulCount       Int          @default(0)
  sentimentScore     Float?
  status             ReviewStatus @default(VISIBLE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  product            Product      @relation(fields: [productId], references: [id])
  user               User         @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

model EmailLog {
  id        String      @id @default(uuid())
  userId    String?
  toEmail   String
  subject   String
  template  String?
  type      EmailType
  status    EmailStatus @default(QUEUED)
  errorMsg  String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id])

  @@index([userId], map: "email_logs_userId_fkey")
  @@map("email_logs")
}

model UserActivityLog {
  id          String       @id @default(uuid())
  userId      String?
  sessionId   String?
  productId   String
  action      ActivityType
  searchQuery String?
  createdAt   DateTime     @default(now())
  product     Product      @relation(fields: [productId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([productId, action])
  @@map("user_activity_logs")
}

model ProductRecommendation {
  id            String   @id @default(uuid())
  productId     String
  recommendedId String
  score         Float
  algorithm     String
  updatedAt     DateTime @updatedAt
  product       Product  @relation("source", fields: [productId], references: [id])
  recommended   Product  @relation("target", fields: [recommendedId], references: [id])

  @@unique([productId, recommendedId, algorithm])
  @@index([productId, algorithm])
  @@index([recommendedId], map: "product_recommendations_recommendedId_fkey")
  @@map("product_recommendations")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@index([productId], map: "wishlists_productId_fkey")
  @@map("wishlists")
}

enum UserRole {
  CUSTOMER
  EMPLOYEE
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING
  CONFIRMED
  HANDED_OVER
  DELIVERING
  COMPLETED
  RETURN_REQUESTED
  RETURN_REJECTED
  RETURNED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  VNPAY
  COD
  STRIPE
}

enum RefundStatus {
  PROCESSING
  COMPLETED
}

enum VoucherType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum VoucherScope {
  CART
  CATEGORY
  PRODUCT
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

enum EmailType {
  OTP
  ORDER_CONFIRM
  ORDER_COMPLETE
  RESET_PASS
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

enum ReturnReason {
  DAMAGED_BROKEN
  DEFECTIVE
  WRONG_ITEM
  MISSING_ACCESSORIES
  USED_PRODUCT
  COUNTERFEIT
  CHANGE_OF_MIND
  DISSATISFIED_DELIVERY
  DISSATISFIED_PRODUCT
}

enum ActivityType {
  VIEW
  CLICK
  SEARCH
  ADD_TO_CART
  REMOVE_FROM_CART
  WISHLIST_ADD
  PURCHASE
}

enum Region {
  NORTH
  CENTRAL
  SOUTH
}

model Province {
  id         String   @id
  name       String
  fullName   String
  region     Region   @default(NORTH)
  mergedFrom String?
  wards      Ward[]

  @@map("provinces")
}

model Ward {
  id         String   @id
  provinceId String
  name       String
  fullName   String
  mergedFrom String?
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  @@index([provinceId], map: "wards_provinceId_fkey")
  @@map("wards")
}
